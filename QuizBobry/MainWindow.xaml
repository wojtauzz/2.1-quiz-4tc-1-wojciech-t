<Window x:Class="QuizBobry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuizBobry.ViewModels"
        xmlns:conv="clr-namespace:QuizBobry.Converters"
        Title="🦫 Quiz o Bobrach" Height="720" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:QuizViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:FeedbackBorderConverter x:Key="FeedbackBorderConv" />
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F2027" Offset="0" />
            <GradientStop Color="#203A43" Offset="0.5" />
            <GradientStop Color="#2C5364" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40" MaxWidth="560" HorizontalAlignment="Center">

            <!-- Header -->
            <TextBlock Text="🦫" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Quiz o Bobrach" FontSize="26" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Sprawdź swoją wiedzę o tych niezwykłych zwierzętach!"
                       FontSize="13" Foreground="#90CAF9" HorizontalAlignment="Center" Margin="0,0,0,20" />

            <!-- ==================== QUIZ PANEL ==================== -->
            <StackPanel Visibility="{Binding ShowQuiz, Converter={StaticResource BoolToVis}}">

                <!-- Progress info -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="12" Foreground="#90CAF9" />
                    <TextBlock Grid.Column="1" Text="{Binding ScoreText}" FontSize="12" Foreground="#90CAF9"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Progress bar -->
                <Border Height="8" CornerRadius="4" Background="#2A3A4A" Margin="0,0,0,22">
                    <Border CornerRadius="4" HorizontalAlignment="Left"
                            Width="{Binding ProgressValue, Converter={x:Static conv:PercentToWidthConverter.Instance}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#4FC3F7" Offset="0" />
                                <GradientStop Color="#00E676" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <!-- Question Card -->
                <Border CornerRadius="14" Background="#1A2636" BorderBrush="#2D3D50" BorderThickness="1"
                        Padding="24,22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding QuestionText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="26" />

                        <Button x:Name="BtnA" Content="{Binding AnswerA}" Tag="0"
                                Command="{Binding SelectAnswerCommand}" CommandParameter="0"
                                Click="AnswerButton_Click"
                                FontSize="14" Foreground="#E0E0E0" HorizontalContentAlignment="Left"
                                Padding="16,14" Margin="0,0,0,10" Cursor="Hand"
                                Background="#2D3748" BorderBrush="#4A5568" BorderThickness="2"
                                Template="{DynamicResource AnswerBtnTemplate}" />
                        <Button x:Name="BtnB" Content="{Binding AnswerB}" Tag="1"
                                Command="{Binding SelectAnswerCommand}" CommandParameter="1"
                                Click="AnswerButton_Click"
                                FontSize="14" Foreground="#E0E0E0" HorizontalContentAlignment="Left"
                                Padding="16,14" Margin="0,0,0,10" Cursor="Hand"
                                Background="#2D3748" BorderBrush="#4A5568" BorderThickness="2"
                                Template="{DynamicResource AnswerBtnTemplate}" />
                        <Button x:Name="BtnC" Content="{Binding AnswerC}" Tag="2"
                                Command="{Binding SelectAnswerCommand}" CommandParameter="2"
                                Click="AnswerButton_Click"
                                FontSize="14" Foreground="#E0E0E0" HorizontalContentAlignment="Left"
                                Padding="16,14" Margin="0,0,0,10" Cursor="Hand"
                                Background="#2D3748" BorderBrush="#4A5568" BorderThickness="2"
                                Template="{DynamicResource AnswerBtnTemplate}" />
                    </StackPanel>
                </Border>

                <!-- Feedback -->
                <Border CornerRadius="10" Background="#1A2636" BorderThickness="0,0,0,3"
                        BorderBrush="{Binding IsCorrect, Converter={StaticResource FeedbackBorderConv}}"
                        Padding="18,14" Margin="0,0,0,14"
                        Visibility="{Binding Answered, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6">
                            <Run Text="{Binding FeedbackIcon, Mode=OneWay}" FontSize="16" />
                            <Run Text="{Binding FeedbackTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                        </TextBlock>
                        <TextBlock Text="{Binding FeedbackExplanation}" TextWrapping="Wrap"
                                   FontSize="13" Foreground="#B0BEC5" LineHeight="21" />
                    </StackPanel>
                </Border>

                <!-- Next Button -->
                <Button Content="{Binding NextButtonText}"
                        Command="{Binding NextQuestionCommand}"
                        Click="NextButton_Click"
                        Visibility="{Binding Answered, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" Padding="28,12" FontSize="14" FontWeight="SemiBold"
                        Foreground="White" Cursor="Hand" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#4FC3F7" Offset="0" />
                                        <GradientStop Color="#0288D1" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- ==================== RESULTS PANEL ==================== -->
            <StackPanel Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="14" Background="#1A2636" BorderBrush="#2D3D50" BorderThickness="1"
                        Padding="30,36" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ResultEmoji}" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Quiz zakończony!" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />

                        <TextBlock HorizontalAlignment="Center" FontSize="48" FontWeight="ExtraBold" Margin="0,12,0,12">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#4FC3F7" Offset="0" />
                                    <GradientStop Color="#00E676" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="{Binding FinalPercentage, Mode=OneWay, StringFormat={}{0}%}" />
                        </TextBlock>

                        <TextBlock Text="{Binding ResultMessage}" FontSize="14" Foreground="#90CAF9"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ResultDetail}" FontSize="13" Foreground="#78909C"
                                   HorizontalAlignment="Center" Margin="0,0,0,24" />

                        <Button Content="🔄  Zagraj ponownie" Command="{Binding RestartCommand}"
                                Click="RestartButton_Click"
                                HorizontalAlignment="Center" Padding="30,14" FontSize="15" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#4FC3F7" Offset="0" />
                                                <GradientStop Color="#0288D1" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
